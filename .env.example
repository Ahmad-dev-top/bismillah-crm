# Copy to .env in this directory for local dev (gitignored).
# Production: /etc/bismillah/api.env (chmod 600, owned root:bismillah).
# NOTHING in this file belongs in the repository or the database.

DATABASE_URL=postgres://bismillah:CHANGE_ME@127.0.0.1:5432/bismillah
REDIS_URL=redis://127.0.0.1:6379
PG_POOL_MAX=8

# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

PORT=3000
LOG_LEVEL=info
# Local Vite: http://localhost:5173. Production DuckDNS: https://YOURSUB.duckdns.org
CORS_ORIGINS=https://YOURSUB.duckdns.org,http://localhost:5173

# WhatsApp Cloud API (Meta official).
# Set WHATSAPP_DRY_RUN=true on staging so no real message can leave.
WHATSAPP_DRY_RUN=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_CONCURRENCY=4

TZ=Asia/Karachi
